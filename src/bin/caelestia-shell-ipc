#!/usr/bin/env bash

set -euo pipefail

_quickshell() {
    if command -v quickshell >/dev/null 2>&1; then
        command -v quickshell
    elif command -v qs >/dev/null 2>&1; then
        command -v qs
    elif [ -x "/usr/bin/quickshell" ]; then
        echo "/usr/bin/quickshell"
    elif [ -x "/usr/local/bin/quickshell" ]; then
        echo "/usr/local/bin/quickshell"
    else
        echo "[ERR] quickshell not found in PATH or standard locations" >&2
        exit 1
    fi
}

QS="$(_quickshell)"

resolve_shell_config() {
    local candidate
    for candidate in \
        /etc/xdg/quickshell/caelestia/shell.qml \
        "$HOME/.config/quickshell/caelestia/shell.qml"
    do
        if [[ -f "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    printf '%s\n' "$HOME/.config/quickshell/caelestia/shell.qml"
}

SHELL_CONFIG="${CAELESTIA_SHELL_CONFIG:-$(resolve_shell_config)}"

_export_shell_env() {
    if [[ "$SHELL_CONFIG" == /etc/xdg/* ]]; then
        export QML2_IMPORT_PATH="${QML2_IMPORT_PATH:-/usr/lib/qt6/qml:/etc/xdg/quickshell/caelestia}"
        export CAELESTIA_LIB_DIR="${CAELESTIA_LIB_DIR:-/usr/lib/caelestia}"
    else
        export QML2_IMPORT_PATH="${QML2_IMPORT_PATH:-$HOME/.local/lib/qt6/qml:$HOME/.config/quickshell/caelestia}"
        export CAELESTIA_LIB_DIR="${CAELESTIA_LIB_DIR:-$HOME/.local/lib/caelestia}"
    fi
}

# nowhere: --daemonize points stdio at /dev/null, which deadlocks Vesktop (issue #402).
_start_shell() {
    if command -v systemd-run >/dev/null 2>&1; then
        local unit="caelestia-shell-start.service" state i
        for i in {1..100}; do
            state="$(systemctl --user is-active "$unit" 2>/dev/null || true)"
            case "$state" in
                activating|reloading)
                    echo "Shell is starting."
                    return 0
                    ;;
                active)
                    echo "Shell is already running."
                    return 0
                    ;;
                deactivating)
                    sleep 0.2
                    ;;
                *)
                    break
                    ;;
            esac
        done
        systemctl --user reset-failed "$unit" 2>/dev/null || true
        systemd-run --user --quiet --collect \
            --unit="caelestia-shell-start" \
            --description="Caelestia Shell" \
            -- "$QS" -n -p "$SHELL_CONFIG"
        return $?
    fi

    exec stdbuf -oL -eL "$QS" -d -n -p "$SHELL_CONFIG"
}

if [[ ! -f "$SHELL_CONFIG" ]]; then
    echo "[ERR] Caelestia shell config not found: $SHELL_CONFIG" >&2
    echo "       Build the shell first: bash scripts/08-build-shell.sh" >&2
    exit 1
fi

_qs_ipc() {
    "$QS" -p "$SHELL_CONFIG" ipc --any-display "$@"
}

_qs_direct() {
    "$QS" -p "$SHELL_CONFIG" "$@"
}

_is_running() {
    pgrep -f "quickshell.*$SHELL_CONFIG" >/dev/null 2>&1
}

case "${1:-}" in
    quit|kill|stop)
        if _is_running; then
            _qs_ipc quit 2>/dev/null || _qs_direct kill 2>/dev/null || true
            echo "Shell stop signal sent."
        else
            echo "Shell is not running."
        fi
        ;;

    show|list)
        _qs_ipc show
        ;;

    log|logs)
        _qs_direct log
        ;;

    call)
        shift
        if [[ $# -eq 0 ]]; then
            echo "Usage: caelestia-shell-ipc call <command> [args...]" >&2
            exit 1
        fi
        _qs_ipc call "$@"
        ;;

    status|running)
        if _is_running; then
            echo "Shell is running (config: $SHELL_CONFIG)"
        else
            echo "Shell is NOT running (config: $SHELL_CONFIG)"
            exit 1
        fi
        ;;

    start|daemon)
        _export_shell_env
        if _is_running; then
            echo "Shell is already running."
        else
            _start_shell
        fi
        ;;

    restart)
        if _is_running; then
            _qs_ipc quit 2>/dev/null || _qs_direct kill 2>/dev/null || true
            for _ in {1..100}; do
                _is_running || break
                sleep 0.2
            done
            if _is_running; then
                _qs_direct kill 2>/dev/null || true
                for _ in {1..50}; do
                    _is_running || break
                    sleep 0.2
                done
            fi
            if _is_running; then
                echo "[ERR] the running shell did not stop" >&2
                exit 1
            fi
        fi
        _export_shell_env
        _start_shell
        ;;

    -h|--help|help|"")
        echo "Caelestia Shell IPC  -  path-based management wrapper"
        echo ""
        echo "Usage: caelestia-shell-ipc <command> [args...]"
        echo ""
        echo "Commands:"
        echo "  start       Launch the shell in the background"
        echo "  quit        Gracefully stop the running shell"
        echo "  restart     Stop and restart the shell"
        echo "  status      Check whether the shell is running"
        echo "  show        List available IPC commands"
        echo "  log         Print the shell log"
        echo "  call <...>  Send a custom IPC call"
        echo ""
        echo "Config path: $SHELL_CONFIG"
        echo "Quickshell:  $QS"
        ;;

    *)
        _qs_ipc call "$@"
        ;;
esac
