#!/usr/bin/env bash
export PATH="$HOME/.local/bin:$PATH"

if ! command -v git &> /dev/null; then
    exit 0
fi

if command -v jq >/dev/null && [ -f "$HOME/.config/caelestia/shell.json" ]; then
    CHECK_UPDATES=$(jq -r '.general.checkUpdates // true' "$HOME/.config/caelestia/shell.json" 2>/dev/null)
    if [ "$CHECK_UPDATES" = "false" ]; then
        exit 0
    fi
fi

STATE_CONFIG="$HOME/.config/quickshell/caelestia"
STATE_HELPER=""
for candidate in \
    "${CAELESTIA_LIB_DIR:-}/update-state.sh" \
    "$HOME/.local/lib/caelestia/update-state.sh" \
    "/usr/share/caelestia/scripts/lib/update-state.sh"; do
    if [ -r "$candidate" ]; then
        STATE_HELPER="$candidate"
        break
    fi
done
if [ -n "$STATE_HELPER" ]; then
    # shellcheck disable=SC1090
    . "$STATE_HELPER"
fi

if command -v update_state_read_branch >/dev/null 2>&1; then
    BRANCH="$(update_state_read_branch "$STATE_CONFIG")"
else
    BRANCH="main"
fi

export GIT_TERMINAL_PROMPT=0
GIT_TIMEOUT=30

ls_status=0
timeout ${GIT_TIMEOUT} git ls-remote --exit-code --heads https://github.com/ladybug-me/caelestia-kde.git "$BRANCH" >/dev/null 2>&1 || ls_status=$?
if [ "$ls_status" -eq 2 ]; then
    echo "[WARN] Branch '$BRANCH' does not exist on the remote; falling back to main." >&2
    BRANCH="main"
    if command -v update_state_set_branch >/dev/null 2>&1; then
        update_state_set_branch "$STATE_CONFIG" "$BRANCH" || true
    fi
fi

if command -v update_state_read_commit >/dev/null 2>&1; then
    _localCommit="$(update_state_read_commit "$STATE_CONFIG")"
else
    _localCommit="$(cat "$STATE_CONFIG/.current_commit" 2>/dev/null)"
fi
CAELESTIA_PENDING=0

if [ -n "$_localCommit" ]; then
    if [ ! -d "$REPO" ]; then
        timeout ${GIT_TIMEOUT} git clone --bare --filter=blob:none https://github.com/ladybug-me/caelestia-kde.git "$REPO" >/dev/null 2>&1 || true
    else
        timeout ${GIT_TIMEOUT} git -C "$REPO" fetch --force origin "$BRANCH:$BRANCH" >/dev/null 2>&1 || true
    fi

    # must not make every branch commit look new either. Issue #565.
    if git -C "$REPO" merge-base --is-ancestor "${_localCommit}" "${BRANCH}" 2>/dev/null; then
        CAELESTIA_PENDING=$(git -C "$REPO" rev-list --count "${_localCommit}..${BRANCH}" 2>/dev/null || echo 0)
    else
        CAELESTIA_PENDING=0
    fi
fi

SYSTEM_PENDING=0

if command -v checkupdates >/dev/null; then
    PACMAN_PENDING=$(checkupdates 2>/dev/null | wc -l)
    SYSTEM_PENDING=$((SYSTEM_PENDING + PACMAN_PENDING))
fi

if command -v flatpak >/dev/null; then
    FLATPAK_PENDING=$(flatpak remote-ls --updates 2>/dev/null | wc -l)
    SYSTEM_PENDING=$((SYSTEM_PENDING + FLATPAK_PENDING))
fi

if command -v dnf >/dev/null; then
    DNF_OUTPUT=$(dnf check-update --quiet 2>/dev/null) || true
    DNF_PENDING=$(echo "$DNF_OUTPUT" | wc -l)
    SYSTEM_PENDING=$((SYSTEM_PENDING + DNF_PENDING))
fi

if command -v apt-get >/dev/null; then
    APT_PENDING=$(apt-get -s upgrade 2>/dev/null | grep -i "^Inst" | wc -l)
    SYSTEM_PENDING=$((SYSTEM_PENDING + APT_PENDING))
fi

CACHE_FILE="$HOME/.cache/caelestia-kde/last_update_counts"
OLD_C=0
OLD_S=0

if [ -f "$CACHE_FILE" ]; then
    read -r OLD_C OLD_S < "$CACHE_FILE"
fi

if [ "$CAELESTIA_PENDING" -gt "${OLD_C:-0}" ] || [ "$SYSTEM_PENDING" -gt "${OLD_S:-0}" ]; then
    TITLE="System Update Available"
    BODY=""

    if [ "$CAELESTIA_PENDING" -gt 0 ] && [ "$SYSTEM_PENDING" -gt 0 ]; then
        TITLE="System & UI Updates Available"
        BODY="$CAELESTIA_PENDING UI commits and $SYSTEM_PENDING system packages."
    elif [ "$CAELESTIA_PENDING" -gt 0 ]; then
        TITLE="Caelestia Update Available"
        BODY="$CAELESTIA_PENDING new commits on $BRANCH branch."
    elif [ "$SYSTEM_PENDING" -gt 0 ]; then
        BODY="$SYSTEM_PENDING new system packages."
    fi

    if [ -n "$BODY" ]; then
        NOTIF_ID_FILE="$HOME/.cache/caelestia-kde/last_update_notif_id"
        LAST_ID=""
        if [ -f "$NOTIF_ID_FILE" ]; then
            LAST_ID=$(cat "$NOTIF_ID_FILE")
        fi

        NOTIF_ARGS=( -w -p -u normal -i system-software-update -a "Caelestia Updates" -t 300000 )
        if [ -n "$LAST_ID" ]; then
            NOTIF_ARGS+=( -r "$LAST_ID" )
        fi

        NOTIF_ARGS+=( -A "run=Install Updates" -A "close=Close" )

        NOTIF_OUT=$(notify-send "${NOTIF_ARGS[@]}" "$TITLE" "$BODY")

        echo "$NOTIF_OUT" | head -n 1 > "$NOTIF_ID_FILE"

        ACTION=$(echo "$NOTIF_OUT" | sed -n '2p')
        if [ "$ACTION" = "run" ]; then
            if [ -x "$HOME/.local/bin/caelestia" ]; then
                "$HOME/.local/bin/caelestia" shell toggleNexus &
            elif command -v caelestia &> /dev/null; then
                caelestia shell toggleNexus &
            fi
        fi
    fi
fi

mkdir -p "$(dirname "$CACHE_FILE")"
echo "$CAELESTIA_PENDING $SYSTEM_PENDING" > "$CACHE_FILE"
